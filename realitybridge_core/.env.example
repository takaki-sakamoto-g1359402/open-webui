RB_ENV=development
RB_APP_NAME=RealityBridge Core
RB_API_HOST=0.0.0.0
RB_API_PORT=8090
RB_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/realitybridge
RB_REDIS_URL=redis://redis:6379/0
RB_EVENT_STREAM=realitybridge.events
RB_EVENT_CONSUMER_GROUP=realitybridge-workers
RB_EVENT_CONSUMER_NAME=worker-1
RB_JWT_SECRET=<change-me>
RB_JWT_ALGORITHM=HS256
RB_JWT_EXPIRE_MINUTES=60
RB_REQUEST_ID_HEADER=x-request-id
RB_SIMULATION_MODE=true
RB_ALLOW_DEVICE_EXECUTION=false
RB_ENABLE_BOOTSTRAP=false
RB_BOOTSTRAP_ADMIN_EMAIL=admin@realitybridge.local
RB_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
