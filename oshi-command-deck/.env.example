# Client-safe public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DISABLE_SERVICE_WORKER=false

# Server-only secrets. Never expose these to client bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
YOUTUBE_DATA_API_KEY=
YOUTUBE_CHANNELS_JSON='[{"talentId":"kuzuha","displayName":"Kuzuha","channelId":"UCxxxx","branch":"jp","languages":["ja"],"tags":["game","collaboration"]}]'
YOUTUBE_API_DATA_RETENTION_DAYS=29
YOUTUBE_MAX_CHANNELS=25
YOUTUBE_MAX_RESULTS=10
YOUTUBE_CACHE_TTL_SECONDS=120
X_BEARER_TOKEN=
X_HANDLES_JSON='[{"talentId":"kuzuha","displayName":"Kuzuha","handle":"example_handle","branch":"jp","languages":["ja"],"tags":["game","collaboration"]}]'
X_MAX_HANDLES=20
X_HANDLES_PER_QUERY=8
X_MAX_RESULTS=25
AI_PARSE_FALLBACK_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
ADMIN_JOB_TOKEN=
CRON_SECRET=
ADMIN_SESSION_SECRET=
STREAMS_READ_SOURCE=adapters
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_SALT=
HOST_RATE_LIMIT_CONFIGURED=false

# Demo mode works without credentials. Set both false with real server credentials to use live provider APIs.
# OSHI_DEMO_MODE is server-only and can override a demo-built public bundle for local/staging dry-runs.
NEXT_PUBLIC_DEMO_MODE=true
OSHI_DEMO_MODE=true
