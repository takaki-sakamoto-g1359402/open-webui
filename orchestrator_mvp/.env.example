# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Storage
DATABASE_URL=sqlite:///./orchestrator_mvp.db
AUDIT_LOG_PATH=./logs/audit.jsonl
SANDBOX_DATA_DIR=./sandbox_data

# LLM (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tool safety defaults
REQUIRE_APPROVAL_FILE_WRITE=true
REQUIRE_APPROVAL_HTTP_GET=true
REQUIRE_APPROVAL_PYTHON_EVAL=true
